rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Función auxiliar: usuario autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Función auxiliar: administrador verificado (root o custom claim asignado por Cloud Functions)
    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email_verified == true && (
          request.auth.token.email == 'maverick6576@gmail.com' ||
          request.auth.token.admin == true
        );
    }

    // Miembro autorizado de una sala de chat (cliente dueño, familiar conectado vía claim, o cuidador)
    function isChatRoomParticipant(roomId) {
      return isAuthenticated() && (
        roomId.matches('^' + request.auth.uid + '_.*') ||
        roomId.matches('.*_' + request.auth.uid + '$') ||
        (request.auth.token.familyId != null && roomId.matches('^' + request.auth.token.familyId + '_.*'))
      );
    }

    // --- Fotos de perfil de cuidadores ---
    // Solo el propietario ({uid}_...) o un administrador puede subir/modificar su avatar.
    match /caregiver_avatars/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        fileName.matches(request.auth.uid + '_.*') ||
        isAdmin()
      ) && (
        request.resource == null || (
          request.resource.size < 15 * 1024 * 1024 &&
          request.resource.contentType.matches('image/.*')
        )
      );
    }

    // --- Documentos de verificación (DNI, Penales) ---
    // Solo el propio cuidador o un administrador puede leer o subir sus documentos;
    // tras aprobación, el cuidador no puede borrar/reemplazar los documentos auditados.
    function isApprovedCaregiver(uid) {
      return firestore.exists(/databases/(default)/documents/caregivers/$(uid)) &&
        firestore.get(/databases/(default)/documents/caregivers/$(uid)).data.get('verificationStatus', '') == 'approved';
    }

    match /caregiver_docs/{fileName} {
      allow read: if isAuthenticated() && (
        fileName.matches(request.auth.uid + '_.*') ||
        isAdmin()
      );
      allow create, update: if isAdmin() || (
        isAuthenticated() &&
        fileName.matches(request.auth.uid + '_.*') &&
        !isApprovedCaregiver(request.auth.uid) &&
        request.resource != null &&
        request.resource.size < 20 * 1024 * 1024 &&
        (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType == 'application/pdf'
        )
      );
      allow delete: if isAdmin() || (
        isAuthenticated() &&
        fileName.matches(request.auth.uid + '_.*') &&
        !isApprovedCaregiver(request.auth.uid)
      );
    }

    // --- Fotos de perfil de clientes / familias ---
    match /client_avatars/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        fileName.matches(request.auth.uid + '_.*') ||
        (request.auth.token.familyId != null && fileName.matches(request.auth.token.familyId + '_.*')) ||
        isAdmin()
      ) && (
        request.resource == null || (
          request.resource.size < 15 * 1024 * 1024 &&
          request.resource.contentType.matches('image/.*')
        )
      );
    }

    // --- Archivos multimedia del chat (fotos, vídeos, PDF y notas de voz) ---
    match /chat_media/{roomId}/{allPaths=**} {
      allow read: if isChatRoomParticipant(roomId) || isAdmin();
      allow write: if (isChatRoomParticipant(roomId) || isAdmin()) && (
        request.resource == null || (
          request.resource.size < 25 * 1024 * 1024 &&
          (
            request.resource.contentType.matches('image/.*') ||
            request.resource.contentType.matches('audio/.*') ||
            request.resource.contentType.matches('video/.*') ||
            request.resource.contentType == 'application/pdf'
          )
        )
      );
    }

    // --- Fotos del Diario del Cuidado de reservas ---
    // Verifica en Firestore la participación real en `bookings/{bookingId}` (no en metadata modificable por el cliente).
    function isBookingJournalParticipant(bookingId) {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/bookings/$(bookingId)) && (
          firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data.caregiverId == request.auth.uid ||
          firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data.clientId == request.auth.uid ||
          (
            request.auth.token.familyId != null &&
            firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data.clientId == request.auth.token.familyId
          ) ||
          (
            firestore.exists(/databases/(default)/documents/clients/$(firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data.clientId)) && (
              firestore.get(/databases/(default)/documents/clients/$(firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data.clientId)).data.get('ownerUid', '') == request.auth.uid ||
              request.auth.uid in firestore.get(/databases/(default)/documents/clients/$(firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data.clientId)).data.get('memberUids', [])
            )
          )
        );
    }

    match /care_journal/{bookingId}/{allPaths=**} {
      allow read: if isAdmin() || isBookingJournalParticipant(bookingId);
      allow create, update: if isAdmin() || (
        isBookingJournalParticipant(bookingId) &&
        request.resource != null &&
        request.resource.size < 15 * 1024 * 1024 &&
        (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType.matches('video/.*') ||
          request.resource.contentType == 'application/pdf'
        )
      );
      allow delete: if isAdmin();
    }

    // --- Archivos generales de la app ---
    match /app_assets/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
