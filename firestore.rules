rules_version = "2";

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Funciones de ayuda
    function isAuthenticated() {
      return request.auth != null;
    }
    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email_verified == true && (
          request.auth.token.email == "maverick6576@gmail.com" ||
          exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
        );
    }
    function isFamilyMember(familyId) {
      return isAuthenticated() && (
        request.auth.uid == familyId ||
        (exists(/databases/$(database)/documents/clients/$(familyId)) && (
          get(/databases/$(database)/documents/clients/$(familyId)).data.get('ownerUid', familyId) == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/clients/$(familyId)).data.get('memberUids', []) ||
          (
            get(/databases/$(database)/documents/clients/$(familyId)).data.get('members', {}) is map &&
            request.auth.uid in get(/databases/$(database)/documents/clients/$(familyId)).data.get('members', {})
          )
        ))
      );
    }
    function isFamilyAdmin(familyId) {
      return isAuthenticated() && (
        (
          request.auth.uid == familyId &&
          (!exists(/databases/$(database)/documents/clients/$(familyId)) ||
            get(/databases/$(database)/documents/clients/$(familyId)).data.get('ownerUid', familyId) == request.auth.uid)
        ) ||
        (exists(/databases/$(database)/documents/clients/$(familyId)) && (
          get(/databases/$(database)/documents/clients/$(familyId)).data.get('ownerUid', familyId) == request.auth.uid ||
          (
            get(/databases/$(database)/documents/clients/$(familyId)).data.get('members', {}) is map &&
            request.auth.uid in get(/databases/$(database)/documents/clients/$(familyId)).data.get('members', {}) &&
            get(/databases/$(database)/documents/clients/$(familyId)).data.members[request.auth.uid].get('role', '') == 'admin'
          )
        ))
      );
    }

    // 2. Colecciones de Usuarios y Administradores
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid == userId &&
        !request.resource.data.keys().hasAny([
          "isAdmin", "stripeCustomerId", "blockedUntil", "status", "accountStatus"
        ]) &&
        (!('role' in request.resource.data) || request.resource.data.role in ["client", "caregiver"]) &&
        (!('activeFamilyId' in request.resource.data) || request.resource.data.activeFamilyId == userId)
      );
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "isAdmin", "stripeCustomerId", "blockedUntil", "status", "accountStatus"
        ]) &&
        (!('role' in request.resource.data) || request.resource.data.role in ["client", "caregiver"]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["activeFamilyId"]) ||
          request.resource.data.activeFamilyId == userId)
      );
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }
    match /admins/{adminId} {
      allow read: if isAuthenticated() && request.auth.token.email_verified == true && (
        request.auth.token.email == adminId || isAdmin()
      );
      allow write: if isAdmin();

      match /private/{docId} {
        allow read, write: if false; // Solo Cloud Functions (secretos TOTP 2FA)
      }
    }

    // 3. Cuidadores y Disponibilidad
    match /caregivers/{caregiverId} {
      allow read: if isAuthenticated() && (
        resource.data.get('verificationStatus', '') == 'approved' ||
        request.auth.uid == caregiverId ||
        isAdmin()
      );
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid == caregiverId &&
        request.resource.data.get('verified', false) == false &&
        request.resource.data.get('isVerified', false) == false &&
        request.resource.data.get('isKycVerified', false) == false &&
        (!('verificationStatus' in request.resource.data) ||
          request.resource.data.verificationStatus in ["pending", "unverified", "manual_review"]) &&
        request.resource.data.get('rating', 0) == 0 &&
        request.resource.data.get('reviewsCount', 0) == 0
      );
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid == caregiverId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "verified", "isVerified", "rating", "reviewsCount",
          "stripeAccountId", "isKycVerified", "noShowsCount",
          "incidentDates", "blockedUntil", "accountStatus", "status"
        ]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["verificationStatus"]) ||
          request.resource.data.verificationStatus in ["pending", "manual_review"])
      );
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == caregiverId);

      // Documentos de verificación sensibles (DNI, Penales, texto OCR) — solo dueño o admin
      match /private/{docId} {
        allow read: if isAuthenticated() && (request.auth.uid == caregiverId || isAdmin());
        allow create, update: if isAdmin() || (
          isAuthenticated() &&
          request.auth.uid == caregiverId &&
          (!exists(/databases/$(database)/documents/caregivers/$(caregiverId)) ||
            get(/databases/$(database)/documents/caregivers/$(caregiverId)).data.get('verificationStatus', '') != 'approved')
        );
        allow delete: if isAdmin();
      }

      match /availability/{date} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && (request.auth.uid == caregiverId || isAdmin());

        match /slots/{slotId} {
          allow read: if isAuthenticated();
          // La reserva/liberación de franjas para familias ocurre atómicamente vía Cloud Functions (Admin SDK).
          allow write: if isAuthenticated() && (request.auth.uid == caregiverId || isAdmin());
        }
      }
    }

    // 4. Familias / Clientes e Invitaciones
    match /clients/{clientId} {
      allow read: if isAuthenticated() && (
        isFamilyMember(clientId) ||
        isAdmin() ||
        exists(/databases/$(database)/documents/clients/$(clientId)/caregiver_access/$(request.auth.uid))
      );
      allow create: if isAuthenticated() && (request.auth.uid == clientId || isAdmin());
      allow update: if isFamilyAdmin(clientId) || isAdmin();
      allow delete: if isAuthenticated() && (request.auth.uid == clientId || isAdmin());

      match /caregiver_access/{caregiverId} {
        allow read: if isAuthenticated() && (
          isFamilyMember(clientId) ||
          request.auth.uid == caregiverId ||
          isAdmin()
        );
        allow write: if false; // Gestionado exclusivamente por Cloud Functions
      }
    }
    match /family_invites/{inviteCode} {
      allow read: if isAuthenticated() && (resource == null || isFamilyAdmin(resource.data.familyId) || isAdmin());
      allow write: if false; // Solo Cloud Functions (createFamilyInvite / revokeFamilyInvite / joinFamilyByCode)
    }

    // 5. Ofertas de Empleo
    match /job_offers/{offerId} {
      allow read: if isAuthenticated();
      allow create: if isFamilyAdmin(request.resource.data.clientId) || isAdmin();
      allow update, delete: if isFamilyAdmin(resource.data.clientId) || isAdmin();

      match /applications/{applicationId} {
        allow read: if isAuthenticated() && (
          isFamilyMember(get(/databases/$(database)/documents/job_offers/$(offerId)).data.clientId) ||
          request.auth.uid == applicationId ||
          resource.data.caregiverId == request.auth.uid ||
          isAdmin()
        );
        allow create: if isAuthenticated() &&
          request.resource.data.caregiverId == request.auth.uid &&
          request.resource.data.status == "pending";
        allow update: if isAuthenticated() && (
          isAdmin() ||
          isFamilyAdmin(get(/databases/$(database)/documents/job_offers/$(offerId)).data.clientId) ||
          (
            resource.data.caregiverId == request.auth.uid &&
            request.resource.data.caregiverId == request.auth.uid &&
            request.resource.data.status == resource.data.status
          )
        );
        allow delete: if isAuthenticated() && (
          resource.data.caregiverId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // 6. Coleccion BOOKINGS: Privadas y Blindadas Financieramente
    match /bookings/{bookingId} {
      function noProtectedFinancialMutation() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "cost", "totalPaid", "caregiverPayout", "clientFee", "clientFeeRate",
          "caregiverCommissionRate", "caregiverCommissionAmount",
          "paymentIntentId", "paymentStatus", "paymentMethodType", "transferGroup",
          "tipAmount", "processedTipPaymentIntents", "bookingPin", "bookingPinHash",
          "clientId", "caregiverId", "offerId", "applicationId", "isJobOffer",
          "discountApplied", "escrowLock", "checkInTime", "checkInMethod", "isPunctual"
        ]);
      }

      allow read: if isAuthenticated() && (
        isFamilyMember(resource.data.clientId) ||
        request.auth.uid == resource.data.caregiverId ||
        isAdmin()
      );

      // Las reservas de pago solo se crean vía Cloud Functions (createSecureBooking) tras calcular precios/descuentos en servidor.
      allow create: if isAdmin();

      allow update: if isAdmin() || (
        isAuthenticated() &&
        noProtectedFinancialMutation() && (
          // A. Familia Administradora: diario, reseña, o apertura/escalado de disputa válida
          (isFamilyAdmin(resource.data.clientId) && (
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "careChecklist", "careNotes", "carePhotoUrls", "reviewPromptDismissed", "isReviewed"
              ])
            ) ||
            (
              resource.data.status in ["confirmed", "completed"] &&
              !(resource.data.escrowStatus in ["released", "released_manual", "released_auto", "resolved_partial", "refunded", "cancelled", "none"]) &&
              request.resource.data.status == resource.data.status &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "escrowStatus", "disputeRequested", "disputeAmount",
                "disputeReason", "disputeDescription", "disputeOpenedAt"
              ]) &&
              request.resource.data.escrowStatus in [resource.data.escrowStatus, "disputed"] &&
              request.resource.data.disputeAmount is number &&
              request.resource.data.disputeAmount > 0 &&
              request.resource.data.disputeAmount <= resource.data.cost
            ) ||
            (
              resource.data.escrowStatus == "disputed" &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(["disputeEscalated"]) &&
              request.resource.data.disputeEscalated == true
            )
          )) ||
          // B. Familiar Colaborador: Diario del Cuidado y Reseñas
          (isFamilyMember(resource.data.clientId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "careChecklist", "careNotes", "carePhotoUrls", "reviewPromptDismissed", "isReviewed"
            ])
          ) ||
          // C. Cuidador asignado: aceptar pending->confirmed, seguimiento en curso (check-in vía Cloud Function), check-out tras check-in, escalado
          (request.auth.uid == resource.data.caregiverId && (
            (
              resource.data.status == "pending" &&
              resource.data.escrowStatus == "held" &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"]) &&
              request.resource.data.status == "confirmed"
            ) ||
            (
              resource.data.status == "confirmed" &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "liveStatus", "onTheWayAt", "careChecklist", "careNotes", "carePhotoUrls"
              ])
            ) ||
            (
              resource.data.status == "confirmed" &&
              resource.data.checkInTime != null &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "liveStatus", "status", "checkOutTime"
              ]) &&
              request.resource.data.status == "completed"
            ) ||
            (
              resource.data.escrowStatus == "disputed" &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(["disputeEscalated"]) &&
              request.resource.data.disputeEscalated == true
            )
          ))
        )
      );

      allow delete: if isAdmin();

      // Subcolección privada con el PIN de entrada y token QR — legible solo por la familia y admins
      match /secrets/{secretId} {
        allow read: if isAuthenticated() && (
          isFamilyMember(get(/databases/$(database)/documents/bookings/$(bookingId)).data.clientId) ||
          isAdmin()
        );
        allow write: if false; // Solo Cloud Functions
      }
    }

    // 7. Coleccion CHATS
    match /chats/{chatId} {
      allow read, write: if isAuthenticated() && (
        isFamilyMember(chatId.split("_")[0]) ||
        chatId.split("_")[1] == request.auth.uid ||
        (resource != null && (isFamilyMember(resource.data.clientId) || request.auth.uid == resource.data.caregiverId)) ||
        isAdmin()
      );

      match /messages/{messageId} {
        function isParticipant() {
          return isAuthenticated() && (
            isFamilyMember(chatId.split("_")[0]) ||
            request.auth.uid == chatId.split("_")[1] ||
            isAdmin()
          );
        }
        function isMessageAuthor(msgData) {
          return isAuthenticated() && (
            msgData.get('senderId', '') == request.auth.uid ||
            (msgData.get('sender', '') == 'Client' && isFamilyMember(chatId.split("_")[0]))
          );
        }

        allow read: if isParticipant();
        allow create: if isParticipant() &&
          isMessageAuthor(request.resource.data) &&
          request.resource.data.get('isRead', false) == false &&
          request.resource.data.get('isDeleted', false) == false;
        allow update: if isAdmin() || (
          isParticipant() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            "senderId", "sender", "receiverId", "timestamp"
          ]) && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isRead", "readAt", "reactions"]) ||
            (
              isMessageAuthor(resource.data) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "isDeleted", "text", "type", "mediaUrl", "reactions"
              ]) &&
              request.resource.data.isDeleted == true
            )
          )
        );
        allow delete: if isAdmin();
      }
    }

    // 8. Colecciones de Sistema
    match /stats/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Solo se escribe via Cloud Functions
    }
    match /client_caregiver_stats/{docId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (resource == null && docId.matches('.*' + request.auth.uid + '.*')) ||
        (resource != null && (isFamilyMember(resource.data.clientId) || request.auth.uid == resource.data.caregiverId))
      );
      allow write: if false; // Solo Cloud Functions (addCompletedHours)
    }
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && (
        request.resource.data.reporterId == request.auth.uid ||
        isFamilyMember(request.resource.data.reporterId)
      );
      allow update, delete: if isAdmin();
    }
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        isFamilyMember(request.resource.data.clientId) &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        'bookingId' in request.resource.data &&
        reviewId == request.resource.data.bookingId &&
        exists(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)) &&
        get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.clientId == request.resource.data.clientId &&
        get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.caregiverId == request.resource.data.caregiverId &&
        get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.get('isReviewed', false) != true &&
        (
          get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == 'completed' ||
          get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.get('escrowStatus', '') in ['released', 'released_manual', 'released_auto', 'resolved_partial']
        );
      allow update, delete: if isAdmin();
    }
    match /experiments/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /rate_limits/{docId} {
      allow read, write: if false; // Solo Cloud Functions
    }
    match /webhook_events/{eventId} {
      allow read, write: if false; // Solo Cloud Functions
    }
  }
}
