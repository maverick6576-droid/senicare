rules_version = "2";

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Funciones de ayuda
    function isAuthenticated() {
      return request.auth != null;
    }
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.admin == true &&
        request.auth.token.admin2fa == true &&
        request.auth.token.email_verified == true;
    }
    function isFamilyMember(familyId) {
      return isAuthenticated() && (
        request.auth.uid == familyId ||
        (exists(/databases/$(database)/documents/clients/$(familyId)) && (
          get(/databases/$(database)/documents/clients/$(familyId)).data.get('ownerUid', familyId) == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/clients/$(familyId)).data.get('memberUids', []) ||
          (
            get(/databases/$(database)/documents/clients/$(familyId)).data.get('members', {}) is map &&
            request.auth.uid in get(/databases/$(database)/documents/clients/$(familyId)).data.get('members', {})
          )
        ))
      );
    }
    function isFamilyAdmin(familyId) {
      return isAuthenticated() && (
        (
          request.auth.uid == familyId &&
          (!exists(/databases/$(database)/documents/clients/$(familyId)) ||
            get(/databases/$(database)/documents/clients/$(familyId)).data.get('ownerUid', familyId) == request.auth.uid)
        ) ||
        (exists(/databases/$(database)/documents/clients/$(familyId)) && (
          get(/databases/$(database)/documents/clients/$(familyId)).data.get('ownerUid', familyId) == request.auth.uid ||
          (
            get(/databases/$(database)/documents/clients/$(familyId)).data.get('members', {}) is map &&
            request.auth.uid in get(/databases/$(database)/documents/clients/$(familyId)).data.get('members', {}) &&
            get(/databases/$(database)/documents/clients/$(familyId)).data.members[request.auth.uid].get('role', '') == 'admin'
          )
        ))
      );
    }

    // 2. Colecciones de Usuarios y Administradores
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid == userId &&
        !request.resource.data.keys().hasAny([
          "isAdmin", "stripeCustomerId", "blockedUntil", "status",
          "accountStatus", "incidentDates", "minorIncidentsCount"
        ]) &&
        (!('role' in request.resource.data) || request.resource.data.role in ["client", "caregiver"]) &&
        (!('activeFamilyId' in request.resource.data) || request.resource.data.activeFamilyId == userId)
      );
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "isAdmin", "stripeCustomerId", "blockedUntil", "status",
          "accountStatus", "incidentDates", "minorIncidentsCount"
        ]) &&
        (!('role' in request.resource.data) || request.resource.data.role in ["client", "caregiver"]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ||
          !('role' in resource.data) ||
          resource.data.role == null ||
          resource.data.role == '') &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["activeFamilyId"]) ||
          request.resource.data.activeFamilyId == userId)
      );
      allow delete: if isAdmin();
    }
    match /admins/{adminId} {
      allow read: if isAdmin() || (
        request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email != null &&
        request.auth.token.email == adminId
      );
      allow write: if false; // Solo Cloud Functions gestionan documentos de administradores

      match /private/{docId} {
        allow read, write: if false; // Solo Cloud Functions (secretos TOTP 2FA)
      }
    }

    // 3. Cuidadores y Disponibilidad
    match /caregivers/{caregiverId} {
      allow read: if isAuthenticated() && (
        resource.data.get('verificationStatus', '') == 'approved' ||
        request.auth.uid == caregiverId ||
        isAdmin()
      );
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid == caregiverId &&
        !request.resource.data.keys().hasAny([
          "stripeAccountId", "isKycVerified", "chargesEnabled", "payoutsEnabled",
          "transfersCapabilityStatus", "officialCertificationVerified", "noShowsCount",
          "incidentDates", "minorIncidentsCount", "lastMinorIncidentAt",
          "lastMinorIncidentReason", "blockedUntil", "accountStatus", "rating", "reviewsCount"
        ]) &&
        request.resource.data.get('verified', false) == false &&
        request.resource.data.get('isVerified', false) == false &&
        (!('status' in request.resource.data) || request.resource.data.status == 'pending') &&
        (!('verificationStatus' in request.resource.data) ||
          request.resource.data.verificationStatus in ["pending", "unverified", "manual_review"])
      );
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid == caregiverId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "verified", "isVerified", "rating", "reviewsCount",
          "stripeAccountId", "isKycVerified", "chargesEnabled", "payoutsEnabled",
          "transfersCapabilityStatus", "officialCertificationVerified", "noShowsCount",
          "incidentDates", "minorIncidentsCount", "lastMinorIncidentAt",
          "lastMinorIncidentReason", "blockedUntil", "accountStatus", "status"
        ]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["verificationStatus"]) ||
          request.resource.data.verificationStatus in ["pending", "manual_review"])
      );
      allow delete: if isAdmin();

      // Documentos de verificación sensibles (DNI, Penales, texto OCR) — solo dueño o admin
      match /private/{docId} {
        allow read: if isAuthenticated() && (request.auth.uid == caregiverId || isAdmin());
        allow create, update: if isAdmin() || (
          isAuthenticated() &&
          request.auth.uid == caregiverId &&
          (!exists(/databases/$(database)/documents/caregivers/$(caregiverId)) ||
            get(/databases/$(database)/documents/caregivers/$(caregiverId)).data.get('verificationStatus', '') != 'approved')
        );
        allow delete: if isAdmin();
      }

      match /availability/{date} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && (request.auth.uid == caregiverId || isAdmin());

        match /slots/{slotId} {
          allow read: if isAuthenticated();
          // La reserva/liberación de franjas para familias ocurre atómicamente vía Cloud Functions (Admin SDK).
          allow write: if isAuthenticated() && (request.auth.uid == caregiverId || isAdmin());
        }
      }
    }

    // 4. Familias / Clientes e Invitaciones
    match /clients/{clientId} {
      allow read: if isAuthenticated() && (
        isFamilyMember(clientId) ||
        isAdmin() ||
        exists(/databases/$(database)/documents/clients/$(clientId)/caregiver_access/$(request.auth.uid))
      );
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid == clientId &&
        !request.resource.data.keys().hasAny(["members", "memberUids"]) &&
        (!('ownerUid' in request.resource.data) || request.resource.data.ownerUid == request.auth.uid)
      );
      allow update: if isAdmin() || (
        isFamilyAdmin(clientId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'ownerUid', 'members', 'memberUids'
        ])
      );
      allow delete: if isAuthenticated() && (request.auth.uid == clientId || isAdmin());

      match /caregiver_access/{caregiverId} {
        allow read: if isAuthenticated() && (
          isFamilyMember(clientId) ||
          request.auth.uid == caregiverId ||
          isAdmin()
        );
        allow write: if false; // Gestionado exclusivamente por Cloud Functions
      }
    }
    match /family_invites/{inviteCode} {
      allow read: if isAuthenticated() && (
        (resource != null && isFamilyAdmin(resource.data.familyId)) ||
        isAdmin()
      );
      allow write: if false; // Solo Cloud Functions (createFamilyInvite / revokeFamilyInvite / joinFamilyByCode)
    }

    // 5. Ofertas de Empleo
    match /job_offers/{offerId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (
        isFamilyAdmin(request.resource.data.clientId) &&
        request.resource.data.status == 'open' &&
        (!('applicationsCount' in request.resource.data) || request.resource.data.applicationsCount == 0) &&
        (!('clientFeeRate' in request.resource.data) ||
          (request.resource.data.clientFeeRate is number && request.resource.data.clientFeeRate >= 0.03)) &&
        (!('isUrgent' in request.resource.data) || request.resource.data.isUrgent == false) &&
        (!('urgencyBonusRate' in request.resource.data) || request.resource.data.urgencyBonusRate == 0) &&
        (!('title' in request.resource.data) ||
          (request.resource.data.title is string && request.resource.data.title.size() <= 200)) &&
        (!('description' in request.resource.data) ||
          (request.resource.data.description is string && request.resource.data.description.size() <= 3000))
      );
      allow update: if isAdmin() || (
        isFamilyAdmin(resource.data.clientId) &&
        request.resource.data.clientId == resource.data.clientId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'urgencyBonusRate', 'isUrgent', 'clientFeeRate', 'applicationsCount'
        ]) &&
        (!('title' in request.resource.data) ||
          (request.resource.data.title is string && request.resource.data.title.size() <= 200)) &&
        (!('description' in request.resource.data) ||
          (request.resource.data.description is string && request.resource.data.description.size() <= 3000))
      );
      allow delete: if isFamilyAdmin(resource.data.clientId) || isAdmin();

      match /applications/{applicationId} {
        allow read: if isAuthenticated() && (
          request.auth.uid == applicationId ||
          resource.data.caregiverId == request.auth.uid ||
          isFamilyMember(get(/databases/$(database)/documents/job_offers/$(offerId)).data.clientId) ||
          isAdmin()
        );
        allow create: if request.auth != null &&
          applicationId == request.auth.uid &&
          request.auth.uid == request.resource.data.caregiverId &&
          request.resource.data.status == "pending" &&
          exists(/databases/$(database)/documents/job_offers/$(offerId)) &&
          get(/databases/$(database)/documents/job_offers/$(offerId)).data.status == 'open' &&
          request.resource.data.proposedPrice is number &&
          request.resource.data.proposedPrice >= 6 &&
          request.resource.data.proposedPrice <= 200 &&
          (!('message' in request.resource.data) ||
            (request.resource.data.message is string && request.resource.data.message.size() <= 2000)) &&
          exists(/databases/$(database)/documents/caregivers/$(request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/caregivers/$(request.auth.uid)).data.get('status', '') == 'approved' ||
            get(/databases/$(database)/documents/caregivers/$(request.auth.uid)).data.get('verificationStatus', '') == 'approved'
          ) &&
          !(get(/databases/$(database)/documents/caregivers/$(request.auth.uid)).data.get('status', '') in ['pending', 'suspended', 'rejected']) &&
          !(get(/databases/$(database)/documents/caregivers/$(request.auth.uid)).data.get('accountStatus', '') in ['suspended', 'rejected']);
        allow update: if isAuthenticated() && (
          isAdmin() ||
          (
            isFamilyAdmin(get(/databases/$(database)/documents/job_offers/$(offerId)).data.clientId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
            request.resource.data.status in ['accepted', 'rejected']
          ) ||
          (
            resource.data.caregiverId == request.auth.uid &&
            request.resource.data.caregiverId == request.auth.uid &&
            resource.data.status == "pending" &&
            request.resource.data.status == "pending" &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['message', 'proposedPrice', 'appliedAt']) &&
            (!('proposedPrice' in request.resource.data) ||
              (request.resource.data.proposedPrice is number &&
                request.resource.data.proposedPrice >= 6 &&
                request.resource.data.proposedPrice <= 200)) &&
            (!('message' in request.resource.data) ||
              (request.resource.data.message is string && request.resource.data.message.size() <= 2000))
          )
        );
        allow delete: if isAuthenticated() && (
          resource.data.caregiverId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // 6. Coleccion BOOKINGS: Privadas y Blindadas Financieramente
    match /bookings/{bookingId} {
      function noProtectedFinancialMutation() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "cost", "totalPaid", "caregiverPayout", "clientFee", "clientFeeRate",
          "caregiverCommissionRate", "caregiverCommissionAmount",
          "paymentIntentId", "paymentStatus", "paymentMethodType", "transferGroup",
          "tipAmount", "processedTipPaymentIntents", "bookingPin", "bookingPinHash",
          "clientId", "caregiverId", "offerId", "applicationId", "isJobOffer",
          "discountApplied", "escrowLock", "checkInTime", "checkOutTime", "checkInMethod", "isPunctual"
        ]);
      }
      function validBookingDiaryBounds() {
        return (
          (!('careNotes' in request.resource.data) ||
            request.resource.data.careNotes == null ||
            (request.resource.data.careNotes is string && request.resource.data.careNotes.size() <= 2000)) &&
          (!('carePhotoUrls' in request.resource.data) ||
            request.resource.data.carePhotoUrls == null ||
            (request.resource.data.carePhotoUrls is list && request.resource.data.carePhotoUrls.size() <= 20))
        );
      }

      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.clientId ||
        request.auth.uid == resource.data.caregiverId ||
        ('familyId' in request.auth.token && request.auth.token.familyId == resource.data.clientId) ||
        isFamilyMember(resource.data.clientId) ||
        isAdmin()
      );

      // Las reservas de pago solo se crean vía Cloud Functions (createSecureBooking) tras calcular precios/descuentos en servidor.
      allow create: if isAdmin();

      allow update: if isAdmin() || (
        isAuthenticated() &&
        noProtectedFinancialMutation() && (
          // A. Familia Administradora: diario, reseña, o apertura/escalado de disputa válida
          (isFamilyAdmin(resource.data.clientId) && (
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "careChecklist", "careNotes", "carePhotoUrls", "reviewPromptDismissed", "isReviewed"
              ]) &&
              validBookingDiaryBounds()
            ) ||
            (
              resource.data.status in ["confirmed", "completed"] &&
              resource.data.escrowStatus == 'held' &&
              request.resource.data.status == resource.data.status &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "escrowStatus", "disputeRequested", "disputeAmount",
                "disputeReason", "disputeDescription", "disputeOpenedAt", "disputeEscalated"
              ]) &&
              request.resource.data.escrowStatus == 'disputed' &&
              request.resource.data.disputeOpenedAt == request.time &&
              (!('disputeEscalated' in request.resource.data) || request.resource.data.disputeEscalated == false) &&
              request.resource.data.disputeAmount is number &&
              request.resource.data.disputeAmount > 0 &&
              request.resource.data.disputeAmount <= resource.data.cost &&
              (!('disputeReason' in request.resource.data) ||
                request.resource.data.disputeReason == null ||
                (request.resource.data.disputeReason is string && request.resource.data.disputeReason.size() <= 300)) &&
              (!('disputeDescription' in request.resource.data) ||
                request.resource.data.disputeDescription == null ||
                (request.resource.data.disputeDescription is string && request.resource.data.disputeDescription.size() <= 2000))
            ) ||
            (
              resource.data.escrowStatus == "disputed" &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(["disputeEscalated"]) &&
              request.resource.data.disputeEscalated == true
            )
          )) ||
          // B. Familiar Colaborador: Diario del Cuidado y Reseñas
          (isFamilyMember(resource.data.clientId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "careChecklist", "careNotes", "carePhotoUrls", "reviewPromptDismissed", "isReviewed"
            ]) &&
            validBookingDiaryBounds()
          ) ||
          // C. Cuidador asignado: aceptar pending->confirmed, seguimiento en curso (check-in y check-out vía Cloud Functions), escalado
          (request.auth.uid == resource.data.caregiverId && (
            (
              resource.data.status == "pending" &&
              resource.data.escrowStatus == "held" &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"]) &&
              request.resource.data.status == "confirmed"
            ) ||
            (
              resource.data.status == "confirmed" &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "liveStatus", "onTheWayAt", "careChecklist", "careNotes", "carePhotoUrls"
              ]) &&
              (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["liveStatus"]) ||
                request.resource.data.liveStatus == "on_the_way") &&
              validBookingDiaryBounds()
            ) ||
            (
              resource.data.escrowStatus == "disputed" &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(["disputeEscalated"]) &&
              request.resource.data.disputeEscalated == true
            )
          ))
        )
      );

      allow delete: if isAdmin();

      // Subcolección privada con el PIN de entrada y token QR — legible solo por la familia y admins
      match /secrets/{secretId} {
        allow read: if isAuthenticated() && (
          isFamilyMember(get(/databases/$(database)/documents/bookings/$(bookingId)).data.clientId) ||
          isAdmin()
        );
        allow write: if false; // Solo Cloud Functions
      }
    }

    // 7. Coleccion CHATS
    match /chats/{chatId} {
      allow read: if isAuthenticated() && (
        (
          chatId.split('_').size() == 2 && (
            isFamilyMember(chatId.split('_')[0]) ||
            chatId.split('_')[1] == request.auth.uid
          )
        ) ||
        (resource != null && (isFamilyMember(resource.data.clientId) || request.auth.uid == resource.data.caregiverId)) ||
        isAdmin()
      );
      allow create, update: if isAuthenticated() && (
        isAdmin() || (
          chatId.split('_').size() == 2 && (
            isFamilyMember(chatId.split('_')[0]) ||
            chatId.split('_')[1] == request.auth.uid
          ) &&
          (!('clientId' in request.resource.data) || request.resource.data.clientId == chatId.split('_')[0]) &&
          (!('caregiverId' in request.resource.data) || request.resource.data.caregiverId == chatId.split('_')[1])
        )
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        function isParticipant() {
          return isAuthenticated() && (
            (
              chatId.split('_').size() == 2 && (
                isFamilyMember(chatId.split('_')[0]) ||
                request.auth.uid == chatId.split('_')[1]
              )
            ) ||
            isAdmin()
          );
        }
        function isMessageAuthor(msgData) {
          return isAuthenticated() && (
            msgData.get('senderId', '') == request.auth.uid ||
            (
              chatId.split('_').size() == 2 &&
              msgData.get('sender', '') == 'Client' &&
              isFamilyMember(chatId.split('_')[0])
            )
          );
        }

        allow read: if isParticipant();
        allow create: if isParticipant() &&
          chatId.split('_').size() == 2 &&
          request.resource.data.senderId == request.auth.uid &&
          (
            (request.resource.data.sender == 'Client' && isFamilyMember(chatId.split('_')[0])) ||
            (request.resource.data.sender == 'Caregiver' && request.auth.uid == chatId.split('_')[1])
          ) &&
          (!('text' in request.resource.data) ||
            (request.resource.data.text is string && request.resource.data.text.size() <= 4000)) &&
          request.resource.data.get('isRead', false) == false &&
          request.resource.data.get('isDeleted', false) == false;
        allow update: if isAdmin() || (
          isParticipant() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            "senderId", "sender", "receiverId", "timestamp"
          ]) &&
          (!('text' in request.resource.data) ||
            (request.resource.data.text is string && request.resource.data.text.size() <= 4000)) && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isRead", "readAt", "reactions"]) ||
            (
              isMessageAuthor(resource.data) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "isDeleted", "text", "type", "mediaUrl", "reactions"
              ]) &&
              request.resource.data.isDeleted == true
            )
          )
        );
        allow delete: if isAdmin();
      }
    }

    // 8. Colecciones de Sistema
    match /stats/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Solo se escribe via Cloud Functions
    }
    match /client_caregiver_stats/{docId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (resource == null && docId.matches('.*' + request.auth.uid + '.*')) ||
        (resource != null && (isFamilyMember(resource.data.clientId) || request.auth.uid == resource.data.caregiverId))
      );
      allow write: if false; // Solo Cloud Functions (addCompletedHours)
    }
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() &&
        (
          request.resource.data.reporterId == request.auth.uid ||
          isFamilyMember(request.resource.data.reporterId)
        ) &&
        request.resource.data.keys().hasOnly([
          'reporterId', 'reportedId', 'bookingId', 'reason', 'description', 'details', 'status', 'createdAt'
        ]) &&
        (!('status' in request.resource.data) || request.resource.data.status == 'open') &&
        (!('reason' in request.resource.data) ||
          (request.resource.data.reason is string && request.resource.data.reason.size() <= 500)) &&
        (!('description' in request.resource.data) ||
          (request.resource.data.description is string && request.resource.data.description.size() <= 2000)) &&
        (!('details' in request.resource.data) ||
          (request.resource.data.details is string && request.resource.data.details.size() <= 2000)) &&
        (!('reportedId' in request.resource.data) ||
          (request.resource.data.reportedId is string && request.resource.data.reportedId.size() <= 128)) &&
        (!('bookingId' in request.resource.data) ||
          (request.resource.data.bookingId is string && request.resource.data.bookingId.size() <= 128));
      allow update, delete: if isAdmin();
    }
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        isFamilyMember(request.resource.data.clientId) &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        (!('comment' in request.resource.data) ||
          request.resource.data.comment == null ||
          (request.resource.data.comment is string && request.resource.data.comment.size() <= 2000)) &&
        'bookingId' in request.resource.data &&
        reviewId == request.resource.data.bookingId &&
        exists(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)) &&
        get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.clientId == request.resource.data.clientId &&
        get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.caregiverId == request.resource.data.caregiverId &&
        get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.get('isReviewed', false) != true &&
        (
          get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == 'completed' ||
          get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.get('escrowStatus', '') in ['released', 'released_manual', 'released_auto', 'resolved_partial']
        );
      allow update, delete: if isAdmin();
    }
    match /experiments/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /admin_alerts/{docId} {
      allow read: if isAdmin();
      allow write: if false; // Solo Cloud Functions
    }
    match /orphan_payment_alerts/{docId} {
      allow read: if isAdmin();
      allow write: if false; // Solo Cloud Functions
    }
    match /rate_limits/{docId} {
      allow read, write: if false; // Solo Cloud Functions
    }
    match /webhook_events/{eventId} {
      allow read, write: if false; // Solo Cloud Functions
    }

    // 9. Regla de Denegación por Defecto (Fallback Explícito)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
