rules_version = "2";

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Funciones de ayuda
    function isAuthenticated() {
      return request.auth != null;
    }
    function isAdmin() {
      return request.auth.token.email == "maverick6576@gmail.com";
    }

    // 2. Colecciones publicas/semi-publicas
    match /users/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && request.auth.token.email == adminId);
    }
    match /caregivers/{caregiverId} {
      allow read: if true; 
      allow write: if isAuthenticated() && (
        request.auth.uid == caregiverId || 
        isAdmin() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["rating", "reviewsCount"]))
      );
      
      match /availability/{date} {
        allow read: if true;
        allow write: if isAuthenticated() && (request.auth.uid == caregiverId || isAdmin());
        
        match /slots/{slotId} {
          allow read: if true;
          allow write: if isAuthenticated(); // Allow clients to book/rollback slots
        }
      }
    }
    match /clients/{clientId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == clientId || isAdmin());
    }
    match /job_offers/{offerId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.auth.uid == request.resource.data.clientId || isAdmin());
      allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.clientId || isAdmin());
      
      match /applications/{applicationId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated(); // Caregivers write, Clients read/update status
      }
    }

    // 3. Coleccion BOOKINGS: Privadas y Seguras
    match /bookings/{bookingId} {
      allow read: if isAuthenticated();
      
      // Permitimos al cliente CREAR
      allow create: if isAuthenticated() && 
                    request.resource.data.clientId == request.auth.uid &&
                    (request.resource.data.status == "pendingPayment" || request.resource.data.status == "pending" || request.resource.data.status == "confirmed");
      
      // Permitimos al cliente actualizar solo si no modifica los campos financieros y no pasa a pending
      allow update: if isAuthenticated() && 
                    (request.auth.uid == resource.data.clientId || request.auth.uid == resource.data.caregiverId) &&
                    (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["cost", "totalPaid", "caregiverPayout", "clientFee", "caregiverCommissionAmount", "escrowStatus", "paymentIntentId", "transferGroup"])) &&
                    (request.resource.data.status == resource.data.status || 
                     request.resource.data.status == "cancelled" || 
                     request.resource.data.status == "cancelledLate" ||
                     request.resource.data.status == "pending" ||
                     request.resource.data.status == "confirmed" ||
                     request.resource.data.status == "completed");
      
      allow delete: if isAdmin();
    }

    // 4. Coleccion CHATS
    match /chats/{chatId} {
      allow read, write: if isAuthenticated() && (
        chatId.split("_")[0] == request.auth.uid ||
        chatId.split("_")[1] == request.auth.uid ||
        (resource != null && (request.auth.uid == resource.data.clientId || request.auth.uid == resource.data.caregiverId)) ||
        isAdmin()
      );
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated() && (
          request.auth.uid == chatId.split("_")[0] || 
          request.auth.uid == chatId.split("_")[1] || 
          isAdmin()
        );
      }
    }
    
    // 5. Colecciones de Sistema
    match /stats/{docId} {
      allow read: if true;
      allow write: if false; // Solo se escribe via Cloud Functions
    }
    match /client_caregiver_stats/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow write: if isAuthenticated();
    }
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isAuthenticated(); // Se debe limitar a clientes que hayan tenido una reserva completada (mejor en Cloud Functions)
    }
  }
}
