rules_version = "2";

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Funciones de ayuda
    function isAuthenticated() {
      return request.auth != null;
    }
    function isAdmin() {
      return request.auth.token.email == "maverick6576@gmail.com";
    }
    function isFamilyMember(familyId) {
      return isAuthenticated() && (
        request.auth.uid == familyId ||
        (exists(/databases/$(database)/documents/clients/$(familyId)) && (
          get(/databases/$(database)/documents/clients/$(familyId)).data.get('ownerUid', familyId) == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/clients/$(familyId)).data.get('memberUids', []) ||
          (
            get(/databases/$(database)/documents/clients/$(familyId)).data.get('members', {}) is map &&
            request.auth.uid in get(/databases/$(database)/documents/clients/$(familyId)).data.get('members', {})
          )
        ))
      );
    }
    function isFamilyAdmin(familyId) {
      return isAuthenticated() && (
        (
          request.auth.uid == familyId &&
          (!exists(/databases/$(database)/documents/clients/$(familyId)) ||
            get(/databases/$(database)/documents/clients/$(familyId)).data.get('ownerUid', familyId) == request.auth.uid)
        ) ||
        (exists(/databases/$(database)/documents/clients/$(familyId)) && (
          get(/databases/$(database)/documents/clients/$(familyId)).data.get('ownerUid', familyId) == request.auth.uid ||
          (
            get(/databases/$(database)/documents/clients/$(familyId)).data.get('members', {}) is map &&
            request.auth.uid in get(/databases/$(database)/documents/clients/$(familyId)).data.get('members', {}) &&
            get(/databases/$(database)/documents/clients/$(familyId)).data.members[request.auth.uid].get('role', '') == 'admin'
          )
        ))
      );
    }

    // 2. Colecciones publicas/semi-publicas
    match /users/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && request.auth.token.email == adminId);
    }
    match /caregivers/{caregiverId} {
      allow read: if true; 
      allow write: if isAuthenticated() && (
        request.auth.uid == caregiverId || 
        isAdmin() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["rating", "reviewsCount"]))
      );
      
      match /availability/{date} {
        allow read: if true;
        allow write: if isAuthenticated() && (request.auth.uid == caregiverId || isAdmin());
        
        match /slots/{slotId} {
          allow read: if true;
          allow write: if isAuthenticated(); // Allow clients to book/rollback slots
        }
      }
    }
    match /clients/{clientId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.auth.uid == clientId || isAdmin());
      allow update: if isFamilyAdmin(clientId) || isAdmin();
      allow delete: if isAuthenticated() && (request.auth.uid == clientId || isAdmin());
    }
    match /family_invites/{inviteCode} {
      allow read: if isAuthenticated() && (resource == null || isFamilyAdmin(resource.data.familyId) || isAdmin());
      allow write: if false; // Solo Cloud Functions (createFamilyInvite / revokeFamilyInvite / joinFamilyByCode)
    }
    match /job_offers/{offerId} {
      allow read: if true;
      allow create: if isFamilyAdmin(request.resource.data.clientId) || isAdmin();
      allow update, delete: if isFamilyAdmin(resource.data.clientId) || isAdmin();
      
      match /applications/{applicationId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated(); // Caregivers write, Clients read/update status
      }
    }

    // 3. Coleccion BOOKINGS: Privadas y Seguras
    match /bookings/{bookingId} {
      allow read: if isAuthenticated();
      
      // Permitimos al Administrador familiar CREAR
      allow create: if isFamilyAdmin(request.resource.data.clientId) &&
                    (request.resource.data.status == "pendingPayment" || request.resource.data.status == "pending" || request.resource.data.status == "confirmed");
      
      // Permitimos actualizar al Administrador familiar o al cuidador (colaboradores solo marcan reseña si no tocan pagos ni estado)
      allow update: if isAuthenticated() &&
                    (isFamilyAdmin(resource.data.clientId) ||
                     request.auth.uid == resource.data.caregiverId ||
                     (isFamilyMember(resource.data.clientId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isReviewed"]))) &&
                    (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["cost", "totalPaid", "caregiverPayout", "clientFee", "caregiverCommissionAmount", "escrowStatus", "paymentIntentId", "transferGroup"])) &&
                    (request.resource.data.status == resource.data.status || 
                     request.resource.data.status == "cancelled" || 
                     request.resource.data.status == "cancelledLate" ||
                     request.resource.data.status == "pending" ||
                     request.resource.data.status == "confirmed" ||
                     request.resource.data.status == "completed");
      
      allow delete: if isAdmin();
    }

    // 4. Coleccion CHATS
    match /chats/{chatId} {
      allow read, write: if isAuthenticated() && (
        isFamilyMember(chatId.split("_")[0]) ||
        chatId.split("_")[1] == request.auth.uid ||
        (resource != null && (isFamilyMember(resource.data.clientId) || request.auth.uid == resource.data.caregiverId)) ||
        isAdmin()
      );
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated() && (
          isFamilyMember(chatId.split("_")[0]) || 
          request.auth.uid == chatId.split("_")[1] || 
          isAdmin()
        );
      }
    }
    
    // 5. Colecciones de Sistema
    match /stats/{docId} {
      allow read: if true;
      allow write: if false; // Solo se escribe via Cloud Functions
    }
    match /client_caregiver_stats/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow write: if isAuthenticated();
    }
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isAuthenticated(); // Se debe limitar a clientes que hayan tenido una reserva completada (mejor en Cloud Functions)
    }
  }
}
